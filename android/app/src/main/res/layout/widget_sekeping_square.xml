<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:contentDescription="@string/widget_open"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/widget_cream"
            android:textSize="10sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageView
            android:id="@+id/widget_eye"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:contentDescription="@string/widget_toggle_amounts"
            android:padding="2dp"
            android:src="@drawable/ic_eye"
            android:tint="@color/widget_muted" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_provider_icon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:contentDescription="@string/widget_provider"
            android:src="@drawable/ic_wallet" />

        <TextView
            android:id="@+id/widget_provider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_provider"
            android:textColor="@color/widget_cream"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:maxLines="1"
        android:text="Total  Rp 0"
        android:textColor="@color/widget_cream"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_provider_balance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Rp 0"
        android:textColor="@color/widget_muted"
        android:textSize="10sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_expense"
            android:clickable="true"
            android:contentDescription="@string/widget_expense"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/widget_expense"
                android:src="@drawable/ic_widget_expense"
                android:tint="@color/widget_icon_expense" />

            <TextView
                android:id="@+id/widget_expense_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_expense"
                android:textColor="@color/widget_cream"
                android:textSize="7sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="4dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_income"
            android:clickable="true"
            android:contentDescription="@string/widget_income"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/widget_income"
                android:src="@drawable/ic_widget_income"
                android:tint="@color/widget_icon_income" />

            <TextView
                android:id="@+id/widget_income_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_income"
                android:textColor="@color/widget_cream"
                android:textSize="7sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_transfer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_transfer"
            android:clickable="true"
            android:contentDescription="@string/widget_transfer"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/widget_transfer"
                android:src="@drawable/ic_widget_transfer"
                android:tint="@color/widget_icon_transfer" />

            <TextView
                android:id="@+id/widget_transfer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_transfer"
                android:textColor="@color/widget_cream"
                android:textSize="7sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
