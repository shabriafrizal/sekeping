<?xml version="1.0" encoding="utf-8"?>
<!--
  4×2. Provider and its balance on one line, the total as the hero figure, and
  three full-width buttons with the label under each icon.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:contentDescription="@string/widget_open"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_provider_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:contentDescription="@string/widget_provider"
            android:src="@drawable/ic_wallet" />

        <TextView
            android:id="@+id/widget_provider"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="7dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_provider"
            android:textColor="@color/widget_cream"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_provider_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Rp 0"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />

        <ImageView
            android:id="@+id/widget_eye"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/widget_chip"
            android:contentDescription="@string/widget_toggle_amounts"
            android:padding="6dp"
            android:src="@drawable/ic_eye"
            android:tint="@color/widget_cream" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_total_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:letterSpacing="0.14"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/widget_muted"
        android:textSize="8sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_total"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Rp 0"
        android:textColor="@color/widget_cream"
        android:textSize="28sp"
        android:textStyle="bold"
        style="@style/WidgetBalance" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_expense"
            android:clickable="true"
            android:contentDescription="@string/widget_expense"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/widget_expense"
                android:src="@drawable/ic_widget_expense"
                android:tint="@color/widget_icon_expense" />

            <TextView
                android:id="@+id/widget_expense_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/widget_expense"
                android:textColor="@color/widget_cream"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_income"
            android:clickable="true"
            android:contentDescription="@string/widget_income"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/widget_income"
                android:src="@drawable/ic_widget_income"
                android:tint="@color/widget_icon_income" />

            <TextView
                android:id="@+id/widget_income_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/widget_income"
                android:textColor="@color/widget_cream"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_transfer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_transfer"
            android:clickable="true"
            android:contentDescription="@string/widget_transfer"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="@string/widget_transfer"
                android:src="@drawable/ic_widget_transfer"
                android:tint="@color/widget_icon_transfer" />

            <TextView
                android:id="@+id/widget_transfer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:maxLines="1"
                android:text="@string/widget_transfer"
                android:textColor="@color/widget_cream"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
