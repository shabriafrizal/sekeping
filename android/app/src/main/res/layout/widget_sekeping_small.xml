<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:contentDescription="@string/widget_open"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_provider_icon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/widget_provider"
                android:src="@drawable/ic_wallet" />

            <TextView
                android:id="@+id/widget_provider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_provider"
                android:textColor="@color/widget_cream"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_eye"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/widget_eye_bg"
                android:contentDescription="@string/widget_toggle_amounts"
                android:padding="6dp"
                android:src="@drawable/ic_eye"
                android:tint="@color/widget_cream" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_balance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/widget_balance"
                android:textAllCaps="true"
                android:textColor="@color/widget_muted"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_provider_balance"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="15sp"
                android:autoSizeMinTextSize="10sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Rp 0"
                android:textColor="@color/widget_cream"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_total_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.08"
                android:text="@string/widget_total"
                android:textAllCaps="true"
                android:textColor="@color/widget_muted"
                android:textSize="8sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="9sp"
                android:autoSizeStepGranularity="1sp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Rp 0"
                android:textColor="@color/widget_cream"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_expense"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_btn_expense"
            android:clickable="true"
            android:contentDescription="@string/widget_expense"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/widget_expense"
                android:src="@drawable/ic_widget_expense"
                android:tint="@color/widget_icon_expense" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_income"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_btn_income"
            android:clickable="true"
            android:contentDescription="@string/widget_income"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/widget_income"
                android:src="@drawable/ic_widget_income"
                android:tint="@color/widget_icon_income" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_transfer"
            android:layout_width="46dp"
            android:layout_height="match_parent"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_btn_transfer"
            android:clickable="true"
            android:contentDescription="@string/widget_transfer"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@string/widget_transfer"
                android:src="@drawable/ic_widget_transfer"
                android:tint="@color/widget_icon_transfer" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
