<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:contentDescription="@string/widget_open"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="7dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/albert_semibold"
                android:text="@string/app_name"
                android:textColor="@color/widget_cream"
                android:textSize="9sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/widget_eye"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:contentDescription="@string/widget_toggle_amounts"
                android:padding="1dp"
                android:src="@drawable/ic_eye"
                android:tint="@color/widget_muted" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/widget_provider_icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:contentDescription="@string/widget_provider"
                android:src="@drawable/ic_wallet" />

            <TextView
                android:id="@+id/widget_provider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/albert_semibold"
                android:maxLines="1"
                android:text="@string/widget_provider"
                android:textColor="@color/widget_cream"
                android:textSize="9sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_balance_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/albert_semibold"
                    android:letterSpacing="0.1"
                    android:text="@string/widget_balance"
                    android:textAllCaps="true"
                    android:textColor="@color/widget_muted"
                    android:textSize="6sp" />

                <TextView
                    android:id="@+id/widget_provider_balance"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/fraunces_semibold"
                    android:maxLines="1"
                    android:text="Rp 0"
                    android:textColor="@color/widget_cream"
                    android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_total_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/albert_semibold"
                    android:letterSpacing="0.1"
                    android:text="@string/widget_total"
                    android:textAllCaps="true"
                    android:textColor="@color/widget_muted"
                    android:textSize="6sp" />

                <TextView
                    android:id="@+id/widget_total"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/fraunces_semibold"
                    android:maxLines="1"
                    android:text="Rp 0"
                    android:textColor="@color/widget_cream"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_marginStart="5dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widget_expense"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_expense"
            android:clickable="true"
            android:contentDescription="@string/widget_expense"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/widget_expense"
                android:src="@drawable/ic_widget_expense"
                android:tint="@color/widget_icon_expense" />

            <TextView
                android:id="@+id/widget_expense_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/albert_medium"
                android:maxLines="1"
                android:text="@string/widget_expense"
                android:textColor="@color/widget_cream"
                android:textSize="6sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_income"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="3dp"
            android:background="@drawable/widget_btn_income"
            android:clickable="true"
            android:contentDescription="@string/widget_income"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/widget_income"
                android:src="@drawable/ic_widget_income"
                android:tint="@color/widget_icon_income" />

            <TextView
                android:id="@+id/widget_income_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/albert_medium"
                android:maxLines="1"
                android:text="@string/widget_income"
                android:textColor="@color/widget_cream"
                android:textSize="6sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_transfer"
            android:layout_width="34dp"
            android:layout_height="match_parent"
            android:background="@drawable/widget_btn_transfer"
            android:clickable="true"
            android:contentDescription="@string/widget_transfer"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:contentDescription="@string/widget_transfer"
                android:src="@drawable/ic_widget_transfer"
                android:tint="@color/widget_icon_transfer" />

            <TextView
                android:id="@+id/widget_transfer_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/albert_medium"
                android:maxLines="1"
                android:text="@string/widget_transfer"
                android:textColor="@color/widget_cream"
                android:textSize="6sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
